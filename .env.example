# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Database. Locally a file in data/. In production, the Turso URL (libsql://...).
DATABASE_URL=file:data/app.db
# Only needed for Turso in production. Leave empty locally.
DATABASE_AUTH_TOKEN=

# Better Auth. A long random string (generate with: openssl rand -base64 32).
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# The address the app runs at.
BETTER_AUTH_URL=http://localhost:3000

# Password given to the default Admins by `npm run seed:admin` (D-013). At least 10 characters.
SEED_ADMIN_PASSWORD=replace-with-the-default-admin-password

# Email through Resend (D-023). Leave both empty to copy links by hand instead.
# Create a key at resend.com → API Keys. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Lumor Sales Hub <sales-hub@example.com>

# AI features (OpenAI, D-036): a key from platform.openai.com → API keys.
# Leave empty to run without AI (the app says "AI isn't set up yet").
OPENAI_API_KEY=sk-replace-with-your-openai-key
# Optional: another OpenAI model than the default (gpt-5.5).
OPENAI_MODEL=

# Scheduled reports (F19): the secret Netlify's scheduled function sends to /api/cron/reports.
# A long random string (generate with: openssl rand -base64 32). Leave empty locally unless
# you want to test the cron route; Run now on Reports works without it.
CRON_SECRET=

# Google Calendar and Meet links (F26): an OAuth "Web application" client from
# console.cloud.google.com (steps in docs/deploy.md). Leave both empty to run without Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Calendly webhook signing key (F27), see docs/deploy.md. Empty = the webhook is closed.
CALENDLY_WEBHOOK_SIGNING_KEY=

# Email through a Gmail account (D-046): used instead of Resend when both are set. The App
# Password is the 16-letter one from myaccount.google.com/apppasswords (needs 2-Step
# Verification), not the normal password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
